{
  "name": "User",
  "type": "object",
  "properties": {
    "account_type": {
      "type": "string",
      "enum": [
        "admin",
        "merchant",
        "buyer"
      ],
      "default": "buyer"
    },
    "display_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending_review",
        "suspended"
      ],
      "default": "active"
    }
  }
}