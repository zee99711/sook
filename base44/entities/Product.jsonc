{
  "name": "Product",
  "type": "object",
  "properties": {
    "merchant_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "stock_quantity": {
      "type": "number",
      "default": 0
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "min_order_qty": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "merchant_id",
    "name",
    "price"
  ]
}